[Unit]
Description=FCV web console v2 legacy (:8080)
After=network-online.target fcv-crane.service
Wants=network-online.target

[Service]
Type=simple
User=user
WorkingDirectory=/home/user/projects/facade_cleaning_v2/web
Environment=WROBOT_IP=192.168.5.26
Environment=CRANE_IP=127.0.0.1
Environment=HTTP_PORT=8080
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=5
StandardOutput=append:/home/user/run/logs/web_service.log
StandardError=append:/home/user/run/logs/web_service.log

[Install]
WantedBy=multi-user.target
